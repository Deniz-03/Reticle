<Application x:Class="Reticle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Reticle.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <views:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <views:NullToVisibilityConverter x:Key="NullToVis"/>
            <views:EnumMatchConverter x:Key="EnumMatch"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

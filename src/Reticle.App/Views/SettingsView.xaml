<UserControl x:Class="Reticle.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="28,24" MaxWidth="560"><TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}"/>
 <CheckBox Content="Mit Windows starten" IsChecked="{Binding LaunchOnStartup}" Margin="0,20,0,8"/><CheckBox Content="Overlay beim Start anzeigen" IsChecked="{Binding OverlayEnabled}" Margin="0,0,0,16"/>
 <TextBlock Text="Sprache (Neustart erforderlich)"/><ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag" Margin="0,4,0,16"><ComboBoxItem Content="System" Tag="{x:Null}"/><ComboBoxItem Content="Deutsch" Tag="de"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
 <WrapPanel><Button Content="Datenordner öffnen" Command="{Binding OpenDataFolderCommand}"/><Button Content="Als Administrator neu starten" Command="{Binding RestartAsAdministratorCommand}"/></WrapPanel>
 </StackPanel>
</UserControl>

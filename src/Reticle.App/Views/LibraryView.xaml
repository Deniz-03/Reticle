<UserControl x:Class="Reticle.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ContextMenu x:Key="CardMenu">
            <MenuItem Header="{x:Static res:Strings.Activate}" Command="{Binding PlacementTarget.Tag.ActivateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="{x:Static res:Strings.Edit}" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="{x:Static res:Strings.Duplicate}" Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="{x:Static res:Strings.Rename}" Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.CopyCode}" Command="{Binding PlacementTarget.Tag.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="{x:Static res:Strings.ExportFile}" Command="{Binding PlacementTarget.Tag.ExportFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="{x:Static res:Strings.ExportPng}" Command="{Binding PlacementTarget.Tag.ExportPngCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.Delete}" Foreground="{StaticResource DangerBrush}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
        </ContextMenu>

        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="ContextMenu" Value="{StaticResource CardMenu}"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnCardDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="148" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,16,16">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{x:Static res:Strings.ImportFile}" Command="{Binding ImportFileCommand}"/>
                <Button Content="{x:Static res:Strings.ImportCode}" Command="{Binding ImportCommand}"/>
                <Button Content="{x:Static res:Strings.New}" Command="{Binding NewCommand}" Style="{StaticResource AccentButton}" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.NavLibrary}" Style="{StaticResource PageTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{x:Static res:Strings.LibraryHint}" Style="{StaticResource DimText}"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- Action bar for the selected crosshair -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="10,8" Margin="0,8,12,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Delete}" Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButton}" Margin="0" VerticalAlignment="Top"/>
                <WrapPanel>
                    <Button Content="{x:Static res:Strings.Activate}" Command="{Binding ActivateCommand}" Style="{StaticResource AccentButton}"/>
                    <Button Content="{x:Static res:Strings.Edit}" Command="{Binding EditCommand}"/>
                    <Button Content="{x:Static res:Strings.Duplicate}" Command="{Binding DuplicateCommand}"/>
                    <Button Content="{x:Static res:Strings.Rename}" Command="{Binding RenameCommand}"/>
                    <Button Content="{x:Static res:Strings.CopyCode}" Command="{Binding CopyCodeCommand}"/>
                    <Button Content="{x:Static res:Strings.ExportFile}" Command="{Binding ExportFileCommand}"/>
                    <Button Content="{x:Static res:Strings.ExportPng}" Command="{Binding ExportPngCommand}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Card grid -->
        <ListBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource CardItem}"
                 SelectionChanged="OnSelectionChanged"
                 Margin="0,16,0,0" AutomationProperties.Name="{x:Static res:Strings.NavLibrary}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Width="126" Height="126" CornerRadius="4" Background="{StaticResource ThumbBackgroundBrush}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="6,2" CornerRadius="4"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static res:Strings.ActiveBadge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource OnAccentBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="2,8,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

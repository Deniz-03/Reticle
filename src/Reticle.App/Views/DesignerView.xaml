<UserControl x:Class="Reticle.App.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:controls="clr-namespace:Reticle.App.Views.Controls"
             xmlns:editors="clr-namespace:Reticle.App.Views.Editors">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ClassicEditorViewModel}">
            <editors:ClassicEditor/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RadialEditorViewModel}">
            <editors:RadialEditor/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShapeEditorViewModel}">
            <editors:ShapeEditor/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageEditorViewModel}">
            <editors:ImageEditor/>
        </DataTemplate>

        <Style x:Key="LayerItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,4,8,4"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnLayerMouseDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="OnLayerMouseMove"/>
            <EventSetter Event="Drop" Handler="OnLayerDrop"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnLayerDoubleClick"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Empty library -->
        <TextBlock Text="{x:Static res:Strings.DesignerEmpty}" Style="{StaticResource DimText}" Margin="28,24"
                   Visibility="{Binding Doc, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>

        <DockPanel Visibility="{Binding Doc, Converter={StaticResource NullToVis}}">
            <!-- Top bar: crosshair name, resolution scaling, activation, undo/redo -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}"
                                ToolTip="{x:Static res:Strings.UndoTip}" AutomationProperties.Name="{x:Static res:Strings.UndoTip}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Command="{Binding RedoCommand}" Margin="0,0,12,0"
                                ToolTip="{x:Static res:Strings.RedoTip}" AutomationProperties.Name="{x:Static res:Strings.RedoTip}"/>
                        <Border Padding="10,5" CornerRadius="{StaticResource Radius}" Background="{StaticResource AccentSoftBrush}"
                                Visibility="{Binding IsActiveDoc, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static res:Strings.ShownOnOverlay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <Button Content="{x:Static res:Strings.Activate}" Command="{Binding ActivateCommand}" Style="{StaticResource AccentButton}"
                                Margin="0" Visibility="{Binding IsActiveDoc, Converter={StaticResource InvBoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding DocName}" Width="240" FontSize="15" FontWeight="SemiBold"
                                 AutomationProperties.Name="{x:Static res:Strings.CrosshairName}"/>
                        <CheckBox Content="{x:Static res:Strings.ScaleWithResolution}" IsChecked="{Binding ScalesWithResolution}"
                                  Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.ScaleWithResolutionTip}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Layers -->
                <DockPanel Margin="12,12,6,12">
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding AddLayerCommand}" CommandParameter="Classic"
                                    ToolTip="{x:Static res:Strings.AddClassic}" AutomationProperties.Name="{x:Static res:Strings.AddClassic}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" Command="{Binding AddLayerCommand}" CommandParameter="Radial"
                                    ToolTip="{x:Static res:Strings.AddRadial}" AutomationProperties.Name="{x:Static res:Strings.AddRadial}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xEA3A;" Command="{Binding AddLayerCommand}" CommandParameter="Shape"
                                    ToolTip="{x:Static res:Strings.AddShape}" AutomationProperties.Name="{x:Static res:Strings.AddShape}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xEB9F;" Command="{Binding AddLayerCommand}" CommandParameter="Image"
                                    ToolTip="{x:Static res:Strings.AddImage}" AutomationProperties.Name="{x:Static res:Strings.AddImage}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Layers}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding MoveLayerUpCommand}"
                                ToolTip="{x:Static res:Strings.MoveUp}" AutomationProperties.Name="{x:Static res:Strings.MoveUp}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74B;" Command="{Binding MoveLayerDownCommand}"
                                ToolTip="{x:Static res:Strings.MoveDown}" AutomationProperties.Name="{x:Static res:Strings.MoveDown}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{Binding DuplicateLayerCommand}"
                                ToolTip="{x:Static res:Strings.Duplicate}" AutomationProperties.Name="{x:Static res:Strings.Duplicate}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" Command="{Binding RenameLayerCommand}"
                                ToolTip="{x:Static res:Strings.Rename}" AutomationProperties.Name="{x:Static res:Strings.Rename}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteLayerCommand}" Foreground="{StaticResource DangerBrush}"
                                ToolTip="{x:Static res:Strings.Delete}" AutomationProperties.Name="{x:Static res:Strings.Delete}"/>
                    </StackPanel>
                    <ListBox x:Name="LayerList" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                             ItemContainerStyle="{StaticResource LayerItem}" AutomationProperties.Name="{x:Static res:Strings.Layers}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource GlyphToggle}" IsChecked="{Binding Visible}"
                                                  Content="&#xE7B3;" ToolTip="{x:Static res:Strings.ToggleVisible}"
                                                  AutomationProperties.Name="{x:Static res:Strings.ToggleVisible}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Preview -->
                <DockPanel Grid.Column="1" Margin="6,12">
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource Panel}" Padding="6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Command="{Binding ZoomOutCommand}"
                                        ToolTip="{x:Static res:Strings.ZoomOut}" AutomationProperties.Name="{x:Static res:Strings.ZoomOut}"/>
                                <TextBlock Text="{Binding Zoom, StringFormat={}{0}×}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Command="{Binding ZoomInCommand}" Margin="4,0,0,0"
                                        ToolTip="{x:Static res:Strings.ZoomIn}" AutomationProperties.Name="{x:Static res:Strings.ZoomIn}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" ToolTip="{x:Static res:Strings.Background}">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Bg" Content="{x:Static res:Strings.BackgroundSample}"
                                             IsChecked="{Binding Background, Converter={StaticResource EnumMatch}, ConverterParameter=Sample}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Bg" Content="{x:Static res:Strings.BackgroundDark}"
                                             IsChecked="{Binding Background, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Bg" Content="{x:Static res:Strings.BackgroundLight}"
                                             IsChecked="{Binding Background, Converter={StaticResource EnumMatch}, ConverterParameter=Light}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Bg" Content="{x:Static res:Strings.BackgroundChecker}"
                                             IsChecked="{Binding Background, Converter={StaticResource EnumMatch}, ConverterParameter=Checker}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="{StaticResource Radius}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <controls:CrosshairPreview x:Name="Preview" Doc="{Binding Doc}" Zoom="{Binding Zoom}" SizeFactor="{Binding PreviewSizeFactor}"
                                                   Backdrop="{Binding Background}" MouseWheel="OnPreviewWheel"/>
                    </Border>
                </DockPanel>

                <!-- Properties -->
                <Border Grid.Column="2" Margin="6,12,12,12" Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,6,10,14" AutomationProperties.Name="{x:Static res:Strings.Properties}">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.NoLayerSelected}" Style="{StaticResource DimText}" Margin="0,10,0,0"
                                       Visibility="{Binding Editor, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>
                            <StackPanel Visibility="{Binding Editor, Converter={StaticResource NullToVis}}">
                                <ContentControl Content="{Binding Editor}" Focusable="False"/>
                                <editors:CommonEditor DataContext="{Binding Editor}"/>
                                <editors:AnimationEditor DataContext="{Binding Editor.Animation}"
                                                         Visibility="{Binding Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

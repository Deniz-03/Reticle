<Window x:Class="Reticle.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Reticle.App.Resources"
        xmlns:vm="clr-namespace:Reticle.App.ViewModels"
        xmlns:views="clr-namespace:Reticle.App.Views"
        Title="{x:Static res:Strings.AppTitle}" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesignerViewModel}">
            <views:DesignerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PositionViewModel}"><views:PositionView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HotkeysViewModel}"><views:HotkeysView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel Margin="28,24">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.PageComingSoon}" Style="{StaticResource DimText}"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" CornerRadius="{StaticResource Radius}" Padding="12,9" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <!-- Brand mark: a ring with a center dot, drawn in code-free vector form. -->
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"/>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"/>
                    </Grid>
                    <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         AutomationProperties.Name="{x:Static res:Strings.NavigationName}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           VerticalAlignment="Center" Width="22"/>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
        <Border Grid.Column="1" VerticalAlignment="Top" Margin="16" Padding="10" Background="{StaticResource AccentSoftBrush}" CornerRadius="{StaticResource Radius}"
                Visibility="{Binding ElevationWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Spiel läuft als Administrator – Reticle als Administrator neu starten, damit Hotkeys funktionieren." Foreground="{StaticResource AccentBrush}"/>
        </Border>
    </Grid>
</Window>

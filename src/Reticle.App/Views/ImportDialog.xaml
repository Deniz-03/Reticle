<Window x:Class="Reticle.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Reticle.App.Resources"
        Title="{x:Static res:Strings.ImportTitle}" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Width="460">
        <TextBlock Text="{x:Static res:Strings.ImportHint}" Style="{StaticResource DimText}" Margin="0,0,0,10"/>
        <TextBox x:Name="CodeBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="84" TextWrapping="Wrap"
                 AcceptsReturn="False" VerticalContentAlignment="Top" FontFamily="Consolas"
                 AutomationProperties.Name="{x:Static res:Strings.ImportTitle}"/>
        <TextBlock Text="{Binding FormatLabel}" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"
                   Visibility="{Binding FormatLabel, Converter={StaticResource NullToVis}}"/>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding Warning, Converter={StaticResource NullToVis}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True"/>
            <Button Content="{x:Static res:Strings.Import}" IsDefault="True" Style="{StaticResource AccentButton}" Margin="0"
                    IsEnabled="{Binding CanImport}" Click="OnImport"/>
        </StackPanel>
    </StackPanel>
</Window>

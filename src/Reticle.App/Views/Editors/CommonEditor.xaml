<UserControl x:Class="Reticle.App.Views.Editors.CommonEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:c="clr-namespace:Reticle.App.Views.Controls">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.SectionLayer}" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.NameLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            <TextBox Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="{x:Static res:Strings.NameLabel}"/>
        </Grid>
        <c:ColorField Label="{x:Static res:Strings.Color}" Hex="{Binding ColorHex}"/>
        <c:NumberField Label="{x:Static res:Strings.Opacity}" Value="{Binding Opacity}" Minimum="0" Maximum="1" Step="0.01" Decimals="2"/>
        <c:NumberField Label="{x:Static res:Strings.Rotation}" Value="{Binding Rotation}" Minimum="-180" Maximum="180" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Scale}" Value="{Binding Scale}" Minimum="0.1" Maximum="8" Step="0.05" Decimals="2"/>
        <c:NumberField Label="{x:Static res:Strings.OffsetX}" Value="{Binding OffsetX}" Minimum="-500" Maximum="500" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.OffsetY}" Value="{Binding OffsetY}" Minimum="-500" Maximum="500" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Blur}" Value="{Binding Blur}" Minimum="0" Maximum="20" Step="0.5" Decimals="1"/>
        <TextBlock Text="{x:Static res:Strings.SectionOutline}" Style="{StaticResource SectionTitle}"/>
        <CheckBox Content="{x:Static res:Strings.OutlineEnabled}" IsChecked="{Binding OutlineEnabled}"/>
        <StackPanel IsEnabled="{Binding OutlineEnabled}">
            <c:NumberField Label="{x:Static res:Strings.Thickness}" Value="{Binding OutlineWidth}" Minimum="0.5" Maximum="10" Step="0.5" Decimals="1"/>
            <c:ColorField Label="{x:Static res:Strings.Color}" Hex="{Binding OutlineColorHex}"/>
            <c:NumberField Label="{x:Static res:Strings.Opacity}" Value="{Binding OutlineOpacity}" Minimum="0" Maximum="1" Step="0.01" Decimals="2"/>
        </StackPanel>
    </StackPanel>
</UserControl>

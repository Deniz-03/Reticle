<UserControl x:Class="Reticle.App.Views.Editors.RadialEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:c="clr-namespace:Reticle.App.Views.Controls">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.SectionArms}" Style="{StaticResource SectionTitle}"/>
        <c:NumberField Label="{x:Static res:Strings.Arms}" Value="{Binding Arms}" Minimum="2" Maximum="8" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.StartAngle}" Value="{Binding StartAngle}" Minimum="0" Maximum="360" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Length}" Value="{Binding Length}" Minimum="1" Maximum="100" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Thickness}" Value="{Binding Thickness}" Minimum="1" Maximum="50" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Gap}" Value="{Binding Gap}" Minimum="-20" Maximum="100" Step="1" Decimals="0"/>
    </StackPanel>
</UserControl>

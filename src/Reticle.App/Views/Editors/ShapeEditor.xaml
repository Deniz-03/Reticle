<UserControl x:Class="Reticle.App.Views.Editors.ShapeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:c="clr-namespace:Reticle.App.Views.Controls">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.SectionShape}" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.ShapeKind}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ShapeEditorViewModel.Kinds}" SelectedValuePath="Value" DisplayMemberPath="Label"
                      SelectedValue="{Binding Kind}" AutomationProperties.Name="{x:Static res:Strings.ShapeKind}"/>
        </Grid>
        <c:NumberField Label="{x:Static res:Strings.Width}" Value="{Binding Width}" Minimum="1" Maximum="256" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Height}" Value="{Binding Height}" Minimum="1" Maximum="256" Step="1" Decimals="0" Visibility="{Binding HasHeight, Converter={StaticResource BoolToVis}}"/>
        <c:NumberField Label="{x:Static res:Strings.StrokeWidth}" Value="{Binding StrokeWidth}" Minimum="1" Maximum="64" Step="0.5" Decimals="1" Visibility="{Binding HasStroke, Converter={StaticResource BoolToVis}}"/>
        <StackPanel Visibility="{Binding IsArc, Converter={StaticResource BoolToVis}}">
            <c:NumberField Label="{x:Static res:Strings.ArcStart}" Value="{Binding ArcStart}" Minimum="-360" Maximum="360" Step="1" Decimals="0"/>
            <c:NumberField Label="{x:Static res:Strings.ArcSweep}" Value="{Binding ArcSweep}" Minimum="-360" Maximum="360" Step="1" Decimals="0"/>
        </StackPanel>
    </StackPanel>
</UserControl>

<UserControl x:Class="Reticle.App.Views.Editors.AnimationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:c="clr-namespace:Reticle.App.Views.Controls">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.SectionAnimation}" Style="{StaticResource SectionTitle}"/>
        <CheckBox Content="{x:Static res:Strings.AnimationEnabled}" IsChecked="{Binding Enabled}"/>
        <StackPanel Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.Trigger}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <Button x:Name="CaptureButton" Grid.Column="1" Margin="0" HorizontalContentAlignment="Left" Click="OnCaptureClick"
                        ToolTip="{x:Static res:Strings.TriggerTip}" AutomationProperties.Name="{x:Static res:Strings.Trigger}">
                    <TextBlock Text="{Binding TriggerText}"/>
                </Button>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.Mode}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:AnimationEditorViewModel.Modes}" SelectedValuePath="Value"
                          DisplayMemberPath="Label" SelectedValue="{Binding Mode}" AutomationProperties.Name="{x:Static res:Strings.Mode}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Keyframes}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WindowBrush}" CornerRadius="{StaticResource Radius}" Padding="10,6,10,8" Margin="0,4">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="0"
                                            Width="24" Height="24" FontSize="10"
                                            Command="{Binding DataContext.RemoveKeyframeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.CanRemoveKeyframe, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            ToolTip="{x:Static res:Strings.RemoveKeyframe}" AutomationProperties.Name="{x:Static res:Strings.RemoveKeyframe}"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <c:NumberField Label="{x:Static res:Strings.DurationMs}" Value="{Binding DurationMs}" Minimum="1" Maximum="2000" Step="10"/>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static res:Strings.Easing}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:AnimationEditorViewModel.Easings}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding Easing}"
                                              AutomationProperties.Name="{x:Static res:Strings.Easing}"/>
                                </Grid>
                                <c:NumberField Label="{x:Static res:Strings.GapAdd}" Value="{Binding GapAdd}" Minimum="-50" Maximum="50" Step="0.5" Decimals="1"/>
                                <c:NumberField Label="{x:Static res:Strings.ScaleMul}" Value="{Binding ScaleMul}" Minimum="0" Maximum="8" Step="0.05" Decimals="2"/>
                                <c:NumberField Label="{x:Static res:Strings.RotationAdd}" Value="{Binding RotationAdd}" Minimum="-360" Maximum="360"/>
                                <c:NumberField Label="{x:Static res:Strings.OpacityMul}" Value="{Binding OpacityMul}" Minimum="0" Maximum="1" Step="0.01" Decimals="2"/>
                                <CheckBox Content="{x:Static res:Strings.AnimateColor}" IsChecked="{Binding HasColor}"/>
                                <c:ColorField Label="{x:Static res:Strings.Color}" Hex="{Binding ColorHex}"
                                              Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{x:Static res:Strings.AddKeyframe}" Command="{Binding AddKeyframeCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>

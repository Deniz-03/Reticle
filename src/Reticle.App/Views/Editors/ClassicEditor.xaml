<UserControl x:Class="Reticle.App.Views.Editors.ClassicEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:c="clr-namespace:Reticle.App.Views.Controls">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.SectionLines}" Style="{StaticResource SectionTitle}"/>
        <c:NumberField Label="{x:Static res:Strings.Length}" Value="{Binding Length}" Minimum="1" Maximum="100" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Thickness}" Value="{Binding Thickness}" Minimum="1" Maximum="50" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Gap}" Value="{Binding Gap}" Minimum="-20" Maximum="100" Step="1" Decimals="0"/>
        <WrapPanel Margin="104,2,0,0">
            <CheckBox Content="{x:Static res:Strings.LineTop}" IsChecked="{Binding Top}" Margin="0,4,14,4"/>
            <CheckBox Content="{x:Static res:Strings.LineBottom}" IsChecked="{Binding Bottom}" Margin="0,4,14,4"/>
            <CheckBox Content="{x:Static res:Strings.LineLeft}" IsChecked="{Binding Left}" Margin="0,4,14,4"/>
            <CheckBox Content="{x:Static res:Strings.LineRight}" IsChecked="{Binding Right}" Margin="0,4,14,4"/>
        </WrapPanel>
        <TextBlock Text="{x:Static res:Strings.SectionDot}" Style="{StaticResource SectionTitle}"/>
        <CheckBox Content="{x:Static res:Strings.DotEnabled}" IsChecked="{Binding DotEnabled}"/>
        <c:NumberField Label="{x:Static res:Strings.Size}" Value="{Binding DotSize}" Minimum="1" Maximum="50" Step="1" Decimals="0"/>
        <CheckBox Content="{x:Static res:Strings.DotRound}" IsChecked="{Binding DotRound}"/>
    </StackPanel>
</UserControl>

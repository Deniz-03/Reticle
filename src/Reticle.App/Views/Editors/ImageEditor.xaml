<UserControl x:Class="Reticle.App.Views.Editors.ImageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Reticle.App.Resources"
             xmlns:vm="clr-namespace:Reticle.App.ViewModels"
             xmlns:c="clr-namespace:Reticle.App.Views.Controls">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.SectionImage}" Style="{StaticResource SectionTitle}"/>
        <DockPanel Margin="0,3">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.ReplaceImage}" Command="{Binding ReplaceImageCommand}" Margin="0"/>
            <TextBlock Text="{Binding ImageInfo}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
        </DockPanel>
        <c:NumberField Label="{x:Static res:Strings.Width}" Value="{Binding Width}" Minimum="1" Maximum="512" Step="1" Decimals="0"/>
        <c:NumberField Label="{x:Static res:Strings.Height}" Value="{Binding Height}" Minimum="1" Maximum="512" Step="1" Decimals="0"/>
    </StackPanel>
</UserControl>
